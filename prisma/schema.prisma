// Uncooked Portal — production schema
// Auth, DPDP erasure, audit, kill-switch, and consent are first-class.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  authUserId           String?   @unique
  role                 String    @default("USER") // USER | ORGANIZER | SUPER_ADMIN
  permissions          String?
  name                 String?
  fullName             String?
  email                String    @unique
  emailVerified        DateTime?
  passwordHash         String?
  dob                  String?
  phoneE164            String?
  department           String?
  clubAssociation      String?
  interests            String?
  preferenceScore      Float     @default(0)
  onboardingCompleted  Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  tokenVersion         Int       @default(0)
  lastLoginAt          DateTime?
  lastLoginIpHash      String?
  ageAttested18        Boolean   @default(false)
  termsAcceptedAt      DateTime?
  termsVersion         String?
  privacyAcceptedAt    DateTime?
  privacyVersion       String?
  disabledAt           DateTime?
  disabledReason       String?
  deletedAt            DateTime?
  deleteRequestedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  registrations        Registration[]
  hostApplication      HostApplication?
  activities           UserActivity[]
  supportTickets       SupportTicket[]
  opportunityApps      OpportunityApplication[]
  auditLogs            AuditLog[]               @relation("AdminAuditLogs")
  consents             ConsentRecord[]
  eventsCreated        Event[]                  @relation("EventCreator")

  @@index([role, createdAt])
  @@index([deletedAt])
  @@index([disabledAt])
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  kind       String
  version    String
  acceptedAt DateTime @default(now())
  ipHash     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  purpose    String

  @@unique([identifier, token, purpose])
  @@index([expires])
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String
  message   String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Event {
  id              String    @id
  title           String
  type            String
  category        String?
  tags            String?
  keywords        String?
  popularityScore Float     @default(0)
  date            DateTime
  location        String
  zone            String?
  city            String    @default("Lucknow")
  state           String    @default("Uttar Pradesh")
  country         String    @default("India")
  description     String
  schedule        String?
  prizePool       String?
  bannerUrl       String?
  ticketType      String    @default("Free")
  price           Float?
  capacity        Int
  waitlistEnabled Boolean   @default(false)
  archived        Boolean   @default(false)
  status          String    @default("Active")
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy       User?     @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  registrations   Registration[]
  ticketTiers     TicketTier[]
  coupons         Coupon[]
  bulletins       BulletinUpdate[]
  activities      UserActivity[]

  @@index([status, date])
  @@index([category, status])
  @@index([createdById])
}

model TicketTier {
  id            String         @id @default(cuid())
  eventId       String
  name          String
  price         Float
  capacity      Int
  available     Int
  description   String?
  createdAt     DateTime       @default(now())
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]
}

model Coupon {
  id           String         @id @default(cuid())
  eventId      String
  code         String
  discountPct  Float
  maxUses      Int
  usedCount    Int            @default(0)
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([eventId, code])
}

model Registration {
  id            String      @id @default(uuid())
  userId        String
  eventId       String
  ticketTierId  String?
  couponId      String?
  status        String      @default("Pending")
  checkInStatus Boolean     @default(false)
  teamName      String?
  track         String?
  registeredAt  DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTier    TicketTier? @relation(fields: [ticketTierId], references: [id])
  coupon        Coupon?     @relation(fields: [couponId], references: [id])

  @@unique([userId, eventId])
  @@index([eventId, status])
}

model HostApplication {
  id               String     @id @default(cuid())
  userId           String     @unique
  organizationName String
  organizationType String
  status           String     @default("PENDING")
  kycProvider      String?
  kycReferenceId   String?
  kycStatus        String?
  documentUrls     String?
  notes            String?
  reviewedAt       DateTime?
  reviewedBy       String?
  rejectionReason  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs        AuditLog[]
}

model BulletinUpdate {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  content   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model UserActivity {
  id               String   @id @default(cuid())
  userId           String
  eventId          String?
  interactionType  String
  metadata         String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
}

model SupportTicket {
  id        String          @id @default(cuid())
  userId    String
  subject   String
  category  String
  status    String          @default("OPEN")
  priority  String          @default("MEDIUM")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  senderId   String
  senderType String
  content    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id           String                    @id @default(cuid())
  title        String
  company      String
  type         String
  location     String
  stipend      String?
  description  String
  requirements String?
  deadline     DateTime?
  status       String                    @default("ACTIVE")
  createdById  String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  applications OpportunityApplication[]

  @@index([status, createdAt])
}

model OpportunityApplication {
  id            String      @id @default(cuid())
  opportunityId String
  userId        String
  resumeUrl     String?
  coverNote     String?
  status        String      @default("PENDING")
  appliedAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
}

model SystemTelemetrySnapshot {
  id            String   @id @default(cuid())
  cpuUsagePct   Float
  memUsagePct   Float
  apiLatencyP95 Int
  dbLatencyMs   Int
  activeUsers   Int
  errorRatePct  Float
  timestamp     DateTime @default(now())
}

model AuditLog {
  id             String           @id @default(cuid())
  adminId        String?
  actorId        String?
  applicationId  String?
  action         String
  entityType     String?
  entityId       String?
  previousStatus String?
  newStatus      String?
  details        String?
  ipHash         String?
  createdAt      DateTime         @default(now())

  admin          User?            @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)
  application    HostApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}
