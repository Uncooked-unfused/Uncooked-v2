# See docs/ENV.md for the full contract. Never commit real secrets.

# --- Required ---
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=
TICKET_HMAC_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uncooked_db?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/uncooked_db?schema=public

# --- Production recommended ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_POOL_MAX=3

# --- Product gates ---
# VERIFIED_HOSTS_ONLY=true

# --- Legal ---
LEGAL_ENTITY_NAME=Uncooked
GRIEVANCE_OFFICER_NAME=Grievance Officer
GRIEVANCE_EMAIL=support@uncooked.in
SUPPORT_EMAIL=support@uncooked.in

# --- Optional OAuth / email ---
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=UNCOOKED <support@uncooked.in>

# --- SMTP Configuration ---
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@uncooked.in
# SMTP_PASS=your_smtp_password
# SMTP_FROM=UNCOOKED <support@uncooked.in>
