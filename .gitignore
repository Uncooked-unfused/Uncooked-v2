# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# execution plans
/execution_plans/

# local/debug auth tooling (never commit again)
/scripts/local-debug/
/scripts/check*.js
/scripts/test*.js
/scripts/*Trigger*.js
/scripts/inspect*.js
/scripts/updateTrigger*.js
/scripts/verifyTrigger.js
/scripts/disableTrigger.js
/scripts/enableTrigger.js

